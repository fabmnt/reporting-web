---
import "../styles/global.css";
import { LANGUAGE_STORAGE_KEY, LOCALES } from "../lib/i18n/locales";
import { THEME_STORAGE_KEY } from "../lib/theme";

interface Props {
  title?: string;
}

const { title = "Reporting Web" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script is:inline define:vars={{ THEME_STORAGE_KEY }}>
      // Applies the theme before first paint to avoid a light/dark flash.
      // Resolution must match src/lib/theme.ts.
      const stored = localStorage.getItem(THEME_STORAGE_KEY);
      const dark =
        stored === "dark" ||
        (stored !== "light" && window.matchMedia("(prefers-color-scheme: dark)").matches);
      document.documentElement.classList.toggle("dark", dark);
      document.documentElement.style.colorScheme = dark ? "dark" : "light";
    </script>
    <script is:inline define:vars={{ LANGUAGE_STORAGE_KEY, LOCALES }}>
      // Marks the document with the visitor's language before first paint, so
      // screen readers and the browser get it right from the start. Resolution
      // must match src/lib/i18n/locales.ts, which keeps it in step afterwards.
      const languageStored = localStorage.getItem(LANGUAGE_STORAGE_KEY);
      const supported = (value) => typeof value === "string" && LOCALES.includes(value);
      const primary = (value) => (value ?? "").toLowerCase().split("-")[0];
      const detected = (navigator.languages ?? [navigator.language]).map(primary).find(supported);
      document.documentElement.lang = supported(languageStored)
        ? languageStored
        : (detected ?? "en");
    </script>
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
