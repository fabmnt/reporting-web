{
  "name": "reporting-web",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "convex dev --start \"astro dev\"",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "NODE_OPTIONS=--no-experimental-webstorage vitest run",
    "test:watch": "NODE_OPTIONS=--no-experimental-webstorage vitest",
    "e2e": "playwright test",
    "typecheck": "astro check",
    "google:token": "node --env-file-if-exists=.env.local scripts/generate-google-token.ts",
    "google:test-sheet": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.e2e scripts/create-google-test-sheet.ts",
    "import:ccc-directory": "node --env-file-if-exists=.env.local scripts/import-ccc-directory.ts",
    "import:legacy-clinics": "node --env-file-if-exists=.env.local scripts/import-legacy-clinics.ts",
    "import:legacy-staff": "node --env-file-if-exists=.env.local scripts/import-legacy-staff.ts"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.5",
    "@base-ui/react": "^1.7.0",
    "@convex-dev/auth": "^0.0.95",
    "@convex-dev/rate-limiter": "^0.3.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "astro": "^7.2.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.6",
    "convex": "^1.45.0",
    "date-fns": "^4.4.0",
    "google-auth-library": "^11.1.0",
    "googleapis": "^182.0.0",
    "jose": "^6.2.10",
    "lucide-react": "^1.39.0",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "shadcn": "^4.19.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.4.1",
    "@vitejs/plugin-react": "^6.1.1",
    "convex-test": "^0.0.58",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
