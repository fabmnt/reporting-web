    "@types/react-dom": "^19.2.5",
    "astro": "^7.2.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.45.0",
    "jose": "^6.2.10",
    "lucide-react": "^1.39.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.19.1",
