# Convex — filled after `npx convex dev`
# CONVEX_DEPLOYMENT=
# CONVEX_URL=
# CONVEX_SITE_URL=

# Convex Auth — set on the Convex deployment, not in this file.
# JWT_PRIVATE_KEY=
# JWKS=
# SITE_URL=http://localhost:4322

# Google Sheets — client credentials go here for the token script.
# The Convex deployment also needs all three, via `npx convex env set`.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=

# Control Central (carrier API) — the Convex deployment reads these to list the
# bots of a clinic for the pending-to-execute report. Set them with
# `npx convex env set`, never in this file.
# CCC_USERNAME=
# CCC_PASSWORD=

# Service accounts — a client can be read with its own Google service account
# instead of the account above. The key is stored by an administrator in the
# app, under Admin / Service accounts, so nothing here is read by the app.
# `pnpm google:test-sheet` uses these to create the spreadsheet the e2e test
# reads, and the test stores the same key through the admin screen. Either the
# downloaded JSON file:
# GOOGLE_SERVICE_ACCOUNT_FILE=/absolute/path/to/key.json
# or the two fields on their own, with the newlines of the key written as \n:
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_SERVICE_ACCOUNT_KEY=

# End-to-end tests — .env.e2e holds the account the browser signs in with, which
# has to be an administrator:
# USERNAME=
# PASSWORD=
